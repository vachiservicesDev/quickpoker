# QuickPoker uses the shared Vachi Supabase project (schema "quickpoker").
# Server only. Never expose the service role key to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser: used only to listen for "room changed" pings. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=https://quickpoker.app

# Optional: email each feedback message to you (https://resend.com, free tier).
# Without a verified domain, Resend only delivers to the address you signed up with.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
# FEEDBACK_FROM_EMAIL="QuickPoker <feedback@your-domain.com>"

# Optional: email visitors (newsletter confirmations, "Email me this board").
# Needs a domain verified in Resend.
# EMAIL_FROM="QuickPoker <hello@your-domain.com>"

# Optional: a Stripe Payment Link for the Facilitator Pro Pack on /toolkit.
# Without it, the button collects a waitlist instead.
# NEXT_PUBLIC_TOOLKIT_PAY_URL=https://buy.stripe.com/...

# Optional: AI retro summaries (https://console.anthropic.com).
# Set both: the key turns on the API, the flag shows the button.
# ANTHROPIC_API_KEY=
# NEXT_PUBLIC_AI_SUMMARY=1
