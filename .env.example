# Server only. Never expose the service role key to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser: used only to listen for "room changed" pings. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=https://quickpoker.app

# Optional: email each feedback message to you (https://resend.com, free tier).
# Without a verified domain, Resend only delivers to the address you signed up with.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
# FEEDBACK_FROM_EMAIL="QuickPoker <feedback@your-domain.com>"
